@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required Qt6 components matching build configuration
set(_qgraphplot_qt_components Core Gui Widgets)
if("@QGRAPHPLOT_BUILD_QML_FRONTEND@")
    list(APPEND _qgraphplot_qt_components Qml Quick)
endif()

find_dependency(Qt6 6.7 REQUIRED COMPONENTS ${_qgraphplot_qt_components})

if(NOT TARGET QGraphPlot::Core)
    include("${CMAKE_CURRENT_LIST_DIR}/QGraphPlotTargets.cmake")
endif()

check_required_components(QGraphPlot)
